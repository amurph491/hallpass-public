#!/usr/bin/env python3
"""Securely import and verify one Hallpass agent credential."""

from __future__ import annotations

import argparse
import base64
import errno
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import re
import secrets
import stat
import sys
import uuid
from typing import Callable
sys.dont_write_bytecode = True  # this directory is a verified install: a __pycache__ in it would fail upgrade and uninstall


def _load_endpoint_module():
    """Load the sibling endpoint module by path (the scripts install as a flat bin/ directory)."""
    path = Path(__file__).absolute().with_name("hallpass_endpoint.py")
    existing = sys.modules.get("hallpass_endpoint")
    if existing is not None and getattr(existing, "__file__", None) == str(path):
        return existing  # one shared instance keeps exception classes identical across helpers
    loader = importlib.machinery.SourceFileLoader("hallpass_endpoint", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise ImportError("hallpass_endpoint is unavailable")
    module = importlib.util.module_from_spec(spec)
    sys.modules["hallpass_endpoint"] = module
    spec.loader.exec_module(module)
    return module


endpoint_rules = _load_endpoint_module()
DEFAULT_ENDPOINT = endpoint_rules.DEFAULT_ENDPOINT
IDENTITY_PATH = "/api/agent/identity"
MAX_RESPONSE_BYTES = endpoint_rules.MAX_RESPONSE_BYTES
CREDENTIAL_PATTERN = re.compile(r"ac1\.([A-Za-z0-9_-]{16,32})\.([A-Za-z0-9_-]{43})\Z")
CLIENTS = ("codex", "claude", "antigravity")


class ImportFailure(Exception):
    """Safe, user-facing import failure; never include bearer or HTTP body text."""


def canonical_agent_id(value: str) -> str:
    try:
        parsed = uuid.UUID(value)
    except (ValueError, AttributeError, TypeError):
        raise ImportFailure("agent ID must be a canonical UUID.") from None
    if str(parsed) != value:
        raise ImportFailure("agent ID must be a canonical lowercase UUID.")
    return value


def validate_credential(value: str) -> str:
    match = CREDENTIAL_PATTERN.fullmatch(value)
    if match is None:
        raise ImportFailure("credential format is invalid.")
    encoded_secret = match.group(2)
    try:
        decoded = base64.urlsafe_b64decode(encoded_secret + "=")
    except (ValueError, base64.binascii.Error):
        raise ImportFailure("credential format is invalid.") from None
    if len(decoded) != 32 or base64.urlsafe_b64encode(decoded).decode("ascii").rstrip("=") != encoded_secret:
        raise ImportFailure("credential format is invalid.")
    return value


def read_hidden_credential() -> str:
    """Require an actual controlling terminal; do not fall back to echoed stdin."""
    try:
        tty_fd = os.open("/dev/tty", os.O_RDWR | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        raise ImportFailure("credential import requires an interactive terminal.") from None
    try:
        if not os.isatty(tty_fd):
            raise ImportFailure("credential import requires an interactive terminal.")
        import getpass

        # getpass reads from /dev/tty itself; this stream only receives the prompt. A read-write text
        # wrapper is not constructible on a tty (it is not seekable), so open it write-only.
        with os.fdopen(tty_fd, "w", encoding="utf-8", closefd=False) as terminal:
            try:
                value = getpass.getpass("Hallpass agent credential (input hidden): ", stream=terminal)
            except (EOFError, OSError):
                raise ImportFailure("could not read credential from the terminal.") from None
        return value
    finally:
        os.close(tty_fd)


def _data_root(environ: dict[str, str] | os._Environ[str] = os.environ) -> Path:
    configured = environ.get("XDG_DATA_HOME")
    if configured:
        root = Path(configured)
        if not root.is_absolute() or ".." in root.parts:
            raise ImportFailure("XDG_DATA_HOME must be an absolute path without parent segments.")
    else:
        home = environ.get("HOME")
        if not home or not Path(home).is_absolute() or ".." in Path(home).parts:
            raise ImportFailure("HOME must be set to an absolute path.")
        root = Path(home) / ".local" / "share"
    return root


def _lstat(path: Path) -> os.stat_result | None:
    try:
        return path.lstat()
    except FileNotFoundError:
        return None
    except OSError:
        raise ImportFailure("cannot inspect credential storage path.") from None


def _check_directory(path: Path, *, private: bool, allow_root_owner: bool = False) -> None:
    info = _lstat(path)
    if info is None or not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise ImportFailure("credential storage directory is missing or unsafe.")
    if info.st_uid != os.getuid() and not (allow_root_owner and info.st_uid == 0):
        raise ImportFailure("credential storage directory must be owned by the current user.")
    mode = stat.S_IMODE(info.st_mode)
    sticky_shared_ancestor = not private and bool(info.st_mode & stat.S_ISVTX)
    if (mode & 0o022 and not sticky_shared_ancestor) or (private and (mode & 0o077 or mode & 0o700 != 0o700)):
        raise ImportFailure("credential storage directory permissions are unsafe.")


def _ensure_private_directories(root: Path, agent_id: str) -> Path:
    # Walk the lexical path from /, rejecting symlinks at every existing component.
    absolute = root.absolute()
    current = Path(absolute.anchor)
    for component in absolute.parts[1:]:
        current = current / component
        info = _lstat(current)
        if info is not None:
            if stat.S_ISLNK(info.st_mode):
                raise ImportFailure("credential storage path must not contain symlinks.")
            if not stat.S_ISDIR(info.st_mode):
                raise ImportFailure("credential storage path contains a non-directory component.")
            if current == absolute and info.st_uid != os.getuid():
                raise ImportFailure("credential data directory must be owned by the current user.")
            _check_directory(current, private=False, allow_root_owner=current != absolute)
        else:
            try:
                os.mkdir(current, 0o700)
            except OSError:
                raise ImportFailure("cannot create credential storage directory.") from None
            os.chmod(current, 0o700, follow_symlinks=False)
            _check_directory(current, private=True)

    # The selected XDG data root itself must belong to this user; root ownership is
    # accepted only for system ancestors above that boundary.
    root_info = _lstat(absolute)
    if root_info is None or not stat.S_ISDIR(root_info.st_mode) or stat.S_ISLNK(root_info.st_mode):
        raise ImportFailure("credential data directory is missing or unsafe.")
    if root_info.st_uid != os.getuid():
        raise ImportFailure("credential data directory must be owned by the current user.")
    root_mode = stat.S_IMODE(root_info.st_mode)
    if root_mode & 0o022 or root_mode & 0o300 != 0o300:
        raise ImportFailure("credential storage directory permissions are unsafe.")

    # The conventional data root may be readable, but Hallpass-owned descendants are private.
    hallpass = absolute / "hallpass"
    credentials = hallpass / "credentials"
    agent_directory = credentials / agent_id
    for directory in (hallpass, credentials, agent_directory):
        info = _lstat(directory)
        if info is None:
            try:
                os.mkdir(directory, 0o700)
            except OSError:
                raise ImportFailure("cannot create credential storage directory.") from None
            os.chmod(directory, 0o700, follow_symlinks=False)
            _check_directory(directory, private=True)
        else:
            if stat.S_ISLNK(info.st_mode):
                raise ImportFailure("credential storage path must not contain symlinks.")
            _check_directory(directory, private=True)
    return agent_directory


def credential_path(agent_id: str, client: str, environ: dict[str, str] | os._Environ[str] = os.environ) -> Path:
    return _data_root(environ) / "hallpass" / "credentials" / agent_id / f"{client}.credential"


def server_name_path(agent_id: str, client: str, environ: dict[str, str] | os._Environ[str] = os.environ) -> Path:
    """Where the MCP server name registered for this agent and client is recorded, beside the credential.

    The name is display and config metadata only. It never selects an agent, tenant, or credential.
    """
    return _data_root(environ) / "hallpass" / "credentials" / agent_id / f"{client}.server-name"


# `hallpass-` plus a 1-24 character slug: lowercase letters, digits, and inner hyphens.
SERVER_NAME_PATTERN = re.compile(r"hallpass-[a-z0-9](?:[a-z0-9-]{0,22}[a-z0-9])?")


def normalize_endpoint(value: str) -> str:
    try:
        return endpoint_rules.normalize_endpoint(value)
    except endpoint_rules.EndpointError as error:
        raise ImportFailure(f"endpoint URL is not acceptable: {error}") from None


def _validate_existing_target(target: Path, label: str = "credential") -> bool:
    info = _lstat(target)
    if info is None:
        return False
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise ImportFailure(f"existing {label} path is not a regular file.")
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise ImportFailure(f"existing {label} file ownership or permissions are unsafe.")
    return True


def credential_exists(agent_id: str, client: str, environ: dict[str, str] | os._Environ[str] = os.environ) -> bool:
    """Read-only: is a credential already imported for this agent and client? Creates nothing."""
    return _validate_existing_target(credential_path(agent_id, client, environ))


def load_profile(agent_id: str, client: str, environ: dict[str, str] | os._Environ[str] = os.environ) -> "endpoint_rules.Profile | None":
    """Read the credential file: the credential together with the endpoint it was verified against, or None if absent.

    A file that is unsafe or malformed is a failure, not None: falling back to the default would send the bearer
    somewhere the user did not choose.
    """
    path = credential_path(agent_id, client, environ)
    for directory in (path.parent.parent.parent, path.parent.parent, path.parent):
        info = _lstat(directory)
        if info is None:
            return None
        if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o700):
            raise ImportFailure("credential directory ownership or permissions are unsafe; set directories to mode 700 and re-import.")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return None
    except OSError:
        raise ImportFailure("credential file cannot be read safely; re-import the credential with --rotate.") from None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
            raise ImportFailure("credential file ownership or permissions are unsafe; set it to mode 600 or re-import with --rotate.")
        raw = os.read(fd, endpoint_rules.MAX_PROFILE_BYTES + 1)
    except OSError:
        raise ImportFailure("credential file cannot be read safely; re-import the credential with --rotate.") from None
    finally:
        os.close(fd)
    profile = endpoint_rules.parse_profile(raw)
    if profile is None:
        raise ImportFailure("credential file has an invalid format; re-import the credential with --rotate.")
    validate_credential(profile.credential)
    return profile


def stored_server_name(agent_id: str, client: str, environ: dict[str, str] | os._Environ[str] = os.environ) -> str | None:
    """The server name recorded by `setup`, or None if none was recorded.

    A record that is unsafe or malformed is a failure, not None: a wrong name could make `remove` or a rename act on
    an entry other than the one setup created.
    """
    path = server_name_path(agent_id, client, environ)
    for directory in (path.parent.parent.parent, path.parent.parent, path.parent):
        info = _lstat(directory)
        if info is None:
            return None
        if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o700):
            raise ImportFailure("credential directory ownership or permissions are unsafe; set directories to mode 700 and re-import.")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return None
    except OSError:
        raise ImportFailure("server name record cannot be read safely; delete it and run setup again.") from None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
            raise ImportFailure("server name record ownership or permissions are unsafe; delete it and run setup again.")
        raw = os.read(fd, 100)
    except OSError:
        raise ImportFailure("server name record cannot be read safely; delete it and run setup again.") from None
    finally:
        os.close(fd)
    invalid = ImportFailure("server name record is invalid; delete it and run setup again.")
    if len(raw) > 99 or not raw.endswith(b"\n") or raw.count(b"\n") != 1:
        raise invalid
    try:
        value = raw[:-1].decode("ascii")
    except UnicodeDecodeError:
        raise invalid from None
    if SERVER_NAME_PATTERN.fullmatch(value) is None:
        raise invalid
    return value


def record_server_name(agent_id: str, client: str, name: str, environ: dict[str, str] | os._Environ[str] = os.environ) -> Path:
    """Record `name` beside the credential: private directory, staged 0600 file, atomic replace, then directory fsync."""
    if SERVER_NAME_PATTERN.fullmatch(name) is None:
        raise ImportFailure("server name is not acceptable.")
    directory = _ensure_private_directories(_data_root(environ), canonical_agent_id(agent_id))
    target = directory / f"{client}.server-name"
    _validate_existing_target(target, "server name record")
    stage = _write_staged(directory, f"{client}.server-name", name + "\n")
    try:
        _validate_existing_target(target, "server name record")
        os.replace(stage, target)
        stage = None
        _fsync_directory(directory)
    except OSError:
        raise ImportFailure("could not record the server name; run setup again to retry.") from None
    finally:
        if stage is not None:
            try:
                stage.unlink()
            except OSError:
                pass
    return target


def delete_server_name(agent_id: str, client: str, environ: dict[str, str] | os._Environ[str] = os.environ) -> bool:
    """Delete the recorded server name if there is one. Returns whether a record was removed."""
    path = server_name_path(agent_id, client, environ)
    if stored_server_name(agent_id, client, environ) is None:
        return False
    try:
        path.unlink()
        _fsync_directory(path.parent)
    except FileNotFoundError:
        return False
    except OSError:
        raise ImportFailure("could not delete the server name record; delete it by hand.") from None
    return True


def stored_endpoint(agent_id: str, client: str, environ: dict[str, str] | os._Environ[str] = os.environ) -> str | None:
    """The endpoint recorded with the credential, or None if there is none (a credential imported before profiles)."""
    profile = load_profile(agent_id, client, environ)
    return profile.endpoint if profile is not None and profile.recorded else None


def _write_staged(directory: Path, name: str, text: str) -> Path:
    """Stage `text` as a private 0600 file beside its final `name`, fsynced and read back."""
    for _ in range(10):
        stage = directory / f".{name}.{secrets.token_hex(12)}.tmp"
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
        try:
            fd = os.open(stage, flags, 0o600)
        except FileExistsError:
            continue
        except OSError:
            raise ImportFailure("could not create protected credential staging file.") from None
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="ascii") as stream:
                stream.write(text)
                stream.flush()
                os.fsync(stream.fileno())
            info = _lstat(stage)
            if info is None or not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
                raise ImportFailure("credential staging file failed its protection check.")
            if stage.read_text(encoding="ascii") != text:
                raise ImportFailure("credential staging file failed its verification check.")
            return stage
        except Exception:
            try:
                stage.unlink()
            except OSError:
                pass
            raise
    raise ImportFailure("could not allocate a unique credential staging file.")


def _wrong_shape() -> ImportFailure:
    return ImportFailure("identity response was malformed.")


def identity_failure_message(failure, endpoint: str) -> str:
    """Safe wording for a failed identity request; never includes the body, headers, or credential."""
    shared = endpoint_rules.describe_failure(failure, "identity")
    if shared is not None:
        return shared if failure.kind in ("too_large", "bad_length", "malformed") else f"identity verification failed: {shared}"
    if failure.kind == "status":
        return f"identity verification failed (HTTP {failure.status}) at {endpoint}."
    return f"identity service at {endpoint} is unavailable; credential was not activated."


def authenticated_agent_id(credential: str, endpoint: str) -> str:
    """Ask the one fixed identity path of `endpoint` who this credential is, without redirects or body leakage."""
    try:
        decoded = endpoint_rules.get_json(endpoint, IDENTITY_PATH, credential)
    except endpoint_rules.RequestFailure as failure:
        raise ImportFailure(identity_failure_message(failure, endpoint)) from None
    except endpoint_rules.EndpointError as error:
        raise ImportFailure(f"endpoint URL is not acceptable: {error}") from None
    if not isinstance(decoded, dict) or set(decoded) != {"agentId"} or not isinstance(decoded["agentId"], str):
        raise _wrong_shape()
    try:
        return canonical_agent_id(decoded["agentId"])
    except ImportFailure:
        raise _wrong_shape() from None


def _fsync_directory(directory: Path) -> None:
    directory_fd = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def import_credential(
    expected_agent: str,
    client: str,
    *,
    rotate: bool = False,
    endpoint: str = DEFAULT_ENDPOINT,
    credential_reader: Callable[[], str] = read_hidden_credential,
    environ: dict[str, str] | os._Environ[str] = os.environ,
    identity_check: Callable[[str, str], str] = authenticated_agent_id,
) -> Path:
    agent_id = canonical_agent_id(expected_agent)
    if client not in CLIENTS:
        raise ImportFailure("client must be codex, claude, or antigravity.")
    endpoint = normalize_endpoint(endpoint)  # before any prompt or filesystem change
    directory = _ensure_private_directories(_data_root(environ), agent_id)
    target = directory / f"{client}.credential"
    exists = _validate_existing_target(target)
    if exists and not rotate:
        raise ImportFailure("credential already exists; use --rotate to replace it after verification.")
    if not exists and rotate:
        raise ImportFailure("there is no existing credential to rotate.")

    value = validate_credential(credential_reader())
    stage: Path | None = None
    try:
        # The credential and its endpoint are one file, so one atomic rename replaces both: a crash can leave the old
        # profile or the new one, never a new credential paired with the previous server.
        stage = _write_staged(directory, f"{client}.credential", endpoint_rules.render_profile(endpoint, value))
        # The credential is sent only to the endpoint it will be recorded against.
        authenticated_id = identity_check(value, endpoint)
        if authenticated_id != agent_id:
            raise ImportFailure("credential authenticated as a different agent; active credential was not changed.")
        # Recheck the target immediately before the atomic replace. The private parent prevents other users racing it.
        current_exists = _validate_existing_target(target)
        if current_exists != exists:
            raise ImportFailure("credential file changed during import; active credential was not changed.")
        if not rotate and current_exists:
            raise ImportFailure("credential already exists; active credential was not changed.")
        os.replace(stage, target)
        stage = None
        _fsync_directory(directory)
        return target
    finally:
        if stage is not None:
            try:
                stage.unlink()
            except OSError:
                pass


class _SafeArgumentParser(argparse.ArgumentParser):
    def error(self, _message: str) -> None:
        # argparse's default error includes rejected argument values, which could be a pasted bearer.
        print("hallpass: invalid credential import arguments.", file=sys.stderr)
        self.print_usage(sys.stderr)
        raise SystemExit(2)


def _parser() -> argparse.ArgumentParser:
    parser = _SafeArgumentParser(prog="hallpass credential import", description="Import one Hallpass agent credential securely.")
    parser.add_argument("--agent", required=True, metavar="UUID")
    parser.add_argument("--client", required=True, choices=CLIENTS)
    parser.add_argument(
        "--url",
        metavar="URL",
        help=f"agent API endpoint: https://HOST[:PORT], or numeric-loopback http. Default: ${endpoint_rules.ENV_ENDPOINT}, then {DEFAULT_ENDPOINT}",
    )
    parser.add_argument("--rotate", action="store_true")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        try:
            endpoint = endpoint_rules.resolve_endpoint(args.url)
        except endpoint_rules.EndpointError as error:
            raise ImportFailure(f"endpoint URL is not acceptable: {error}") from None
        destination = import_credential(args.agent, args.client, rotate=args.rotate, endpoint=endpoint)
    except ImportFailure as failure:
        print(f"hallpass: {failure}", file=sys.stderr)
        return 1
    except OSError as error:
        name = errno.errorcode.get(error.errno, "unknown") if isinstance(error.errno, int) else "unknown"
        endpoint_rules.report_unexpected(error, f"a filesystem operation on credential storage failed ({name}); active credential was not changed.")
        return 1
    except Exception as error:
        # Never print the exception's text: it can carry values. Its type and frames are opt-in (HALLPASS_DEBUG=1).
        endpoint_rules.report_unexpected(error, "credential import failed unexpectedly; active credential was not changed.")
        return 1
    print(f"Credential verified for agent {args.agent} against {endpoint} and saved to {destination}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
